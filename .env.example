# --- Web / social search (required unless you run with --mock-search) ---
# Create a Google Cloud project, enable the "Cloud Vision API", then create
# an API key under APIs & Services > Credentials. Free tier: 1000 units/month.
GOOGLE_VISION_API_KEY=

# --- Blockchain (only required for --network amoy; local network needs nothing) ---
# Public RPC for Polygon's Amoy testnet (or use your own Alchemy/Infura URL)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Private key of a funded Amoy testnet account (get free test MATIC from
# https://faucet.polygon.technology/). NEVER put a mainnet key here.
CHAIN_PRIVATE_KEY=
