# --- Web / social search (required unless you run with --mock-search) ---
# Which backend to use for a real search: "google" or "serpapi".
# Also settable per-run with --search-provider (that flag wins if passed).
SEARCH_PROVIDER=serpapi

# Option A: Google Cloud Vision. Create a Google Cloud project, enable the
# "Cloud Vision API", then create an API key under APIs & Services >
# Credentials. Free tier: 1000 units/month -- but Google requires billing
# to be enabled on the project even to use it (see README).
GOOGLE_VISION_API_KEY=

# Option B: SerpApi (Google Reverse Image search) -- no billing/card
# required for the free plan (~100 searches/month). Sign up at
# https://serpapi.com/ and paste your key below.
SERPAPI_API_KEY=

# SerpApi needs a public URL to the image (it can't accept a direct
# upload), so this backend temporarily hosts the face crop in your own
# Dropbox App folder and deletes it right after the search. Free, no card
# required: create an app at https://www.dropbox.com/developers/apps
# (Scoped access, with files.content.write / files.content.read /
# sharing.write permissions), then generate an access token on the app's
# page and paste it below.
DROPBOX_ACCESS_TOKEN=

# --- Blockchain (only required for --network amoy; local network needs nothing) ---
# Public RPC for Polygon's Amoy testnet (or use your own Alchemy/Infura URL)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Private key of a funded Amoy testnet account (get free test MATIC from
# https://faucet.polygon.technology/). NEVER put a mainnet key here.
CHAIN_PRIVATE_KEY=
